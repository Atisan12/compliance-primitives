# Example environment for deploying/invoking a contract from this repo
# against Stellar testnet. Copy to `testnet.env`, fill in your values, and
# `source testnet.env` before running the Quick start commands in the
# README or scripts/deploy-testnet.sh.

# Name of a local Soroban/Stellar CLI identity to sign transactions with.
# Create one first with:
#   stellar keys generate --global my-testnet-key --network testnet
# then set this to that identity's name (not its address).
STELLAR_SOURCE=my-testnet-key

# Network alias understood by the Stellar CLI's built-in network presets.
# `stellar contract deploy ... --network testnet` already implies the
# passphrase/RPC URL below, so this is only needed if you're calling the
# CLI without `--network` and passing `--rpc-url`/`--network-passphrase`
# explicitly instead.
STELLAR_NETWORK=testnet
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
